# Dirtchat environment variables
# Copy this file to `.env.local` and fill in real values.
# DO NOT commit `.env.local` or any file containing real secrets.

# -----------------------------------------------------------------------------
# Public Supabase values (safe to expose to the browser)
# -----------------------------------------------------------------------------
# Supabase project URL — e.g. https://abcdefghij.supabase.co
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anonymous (publishable) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# -----------------------------------------------------------------------------
# Server-only values (NEVER prefix with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# Supabase service role key. Used by server-side code that needs to bypass
# RLS — for example, reading the encrypted provider secrets table.
# Generate in Supabase dashboard: Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 32-byte (256-bit) base64-encoded key for AES-256-GCM encryption of
# provider API keys at rest. Required for Prompt 2 to save provider keys.
#
# Generate one with Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Or with OpenSSL:
#   openssl rand -base64 32
PROVIDER_KEY_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# -----------------------------------------------------------------------------
# Future LLM provider variables (NOT required in Prompt 2)
# -----------------------------------------------------------------------------
# Provider keys are now stored encrypted per-user in the database. These
# unprefixed variables are placeholders for future prompt-time fallbacks
# only — do not put real keys in this file.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# TOKENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Optional chat streaming tuning (Prompt 4)
# -----------------------------------------------------------------------------
# HTTP timeout per streaming request in milliseconds. Default 60000.
# CHAT_STREAM_TIMEOUT_MS="60000"

# Max input characters per chat message. Default 20000.
# CHAT_MAX_INPUT_CHARS="20000"

# Max messages included in the provider context window. Default 30.
# CHAT_CONTEXT_MAX_MESSAGES="30"

# Max total characters for the provider context window. Default 60000.
# CHAT_CONTEXT_MAX_CHARS="60000"

# Default max output tokens for provider completions. Default 4096.
# CHAT_DEFAULT_MAX_TOKENS="4096"

# -----------------------------------------------------------------------------
# Optional model discovery tuning (Prompt 3)
# -----------------------------------------------------------------------------
# Per-discovery HTTP timeout in milliseconds. Used for both the
# GET /models probe and the fallback chat-completions ping. Default 10000.
# MODEL_DISCOVERY_TIMEOUT_MS="10000"

# Hard cap on the number of models persisted from a single discovery run.
# Default 500.
# MODEL_DISCOVERY_MAX_MODELS_PER_RUN="500"
