# Dirtchat environment variables
# Copy this file to `.env.local` and fill in real values.
# DO NOT commit `.env.local` or any file containing real secrets.

# Supabase project URL — e.g. https://abcdefghij.supabase.co
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anonymous (publishable) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ---- Server-only variables (not required in Prompt 1) ----
# SUPABASE_SERVICE_ROLE_KEY is intentionally NOT required in Prompt 1.
# When server-side privileged operations are added in a later prompt,
# add SUPABASE_SERVICE_ROLE_KEY here and use it ONLY in server code.

# ---- LLM provider variables (NOT required in Prompt 1) ----
# Provider keys will be added in Prompt 2. Do not put real keys in this file.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# TOKENROUTER_API_KEY=
